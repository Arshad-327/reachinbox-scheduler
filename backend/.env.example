# ---- runtime ----
NODE_ENV=development
PORT=4000

# ---- database ----
DATABASE_URL=postgresql://scheduler:scheduler@localhost:5432/email_scheduler

# ---- redis (BullMQ) ----
REDIS_HOST=localhost
# Host port 6379 was already in use on the dev machine, so docker-compose
# publishes Redis on 6380 instead. The container itself still listens on
# 6379 internally -- only the host-side binding moved.
REDIS_PORT=6380
REDIS_PASSWORD=

# ---- auth ----
JWT_SECRET=replace-me-with-a-32-byte-hex-secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---- frontend ----
FRONTEND_URL=http://localhost:3000

# ---- worker / throughput ----
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100
MAX_EMAILS_PER_HOUR_GLOBAL=500
# one of: per_sender | global | both
RATE_LIMIT_STRATEGY=per_sender
MAX_JOB_ATTEMPTS=3

# ---- restart survival ----
# Must exceed the worker's 60s BullMQ lockDuration, so a genuinely in-flight
# job is never reclaimed out from under a live worker.
STUCK_JOB_THRESHOLD_MS=120000
RECONCILE_ON_BOOT=true

# ---- smtp senders (JSON array) ----
SMTP_ACCOUNTS=[{"user":"x@ethereal.email","pass":"y","host":"smtp.ethereal.email","port":587,"fromName":"Oliver Brown"}]
